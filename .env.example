# Optional Firecrawl fallback when native The Numbers fetch is blocked.
FIRECRAWL_API_KEY=

# Cap Firecrawl scrapes per ingest process (default 20).
# FIRECRAWL_MAX_PER_RUN=20

# TMDB v3 API key for upcoming theatrical release ingest.
TMDB_API_KEY=

# Contact email included in the SEC EDGAR user agent, per SEC fair-access policy.
SEC_EDGAR_CONTACT=

# Optional override for the local Wrangler D1 sqlite file.
# D1_LOCAL_PATH=

# Remote ingest mode (GitHub Actions / production writers).
# INGEST_REMOTE_URL=https://theater-industry-dashboard.<account>.workers.dev
# INGEST_TOKEN=
