    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "node-html-parser": "^9.0.2",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "2.8.2",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
